#!/bin/sh
# yami login screen: greetd starts this as its greeter user (/etc/greetd/config.toml). niri draws,
# yami-greet asks for the password and hands it to greetd. yami-greet tells how the start went in
# $XDG_RUNTIME_DIR/yami-greet.status before it leaves: «up» (first frame shown), «session» (greetd
# took the session). A start that never showed a frame is tried again (a GPU driver still loading);
# two such starts in a row, or a missing niri / yami-greet, and greetd's text greeter takes this one
# login, so the machine always lets you in; the next start tries the pixel one again.
# Log: /var/lib/yami-greet/log/greet.log (the last result in .../last), one line per start in the
# system log (journalctl -t yami-greet, or syslog). Nothing is written to the terminal: text there
# makes the console take the screen over between the login screen and the session.
umask 077
G=/usr/local/bin/yami-greet
ST=/var/lib/yami-greet/state
LG=/var/lib/yami-greet/log
LOG=$LG/greet.log

# 3, 4, 5: the terminal, kept for the text login and for niri; everything else goes to the log
exec 3>&1 4>&2 5<&0
if [ -d "$LG" ] && [ -w "$LG" ] && [ ! -L "$LOG" ]; then
    # one file for many starts, the older half moves aside past 256 KB
    [ -f "$LOG" ] && [ "$(wc -c <"$LOG")" -gt 262144 ] && mv -f "$LOG" "$LOG.1"
    exec >>"$LOG" 2>&1
    chmod 644 "$LOG" 2>/dev/null
    # niri gives what it starts /dev/null: yami-greet writes here itself (kdl.rs)
    export YAMI_GREET_LOG="$LOG"
else
    exec >/dev/null 2>&1
fi

say() {
    echo "$(date '+%F %T') $*"
    command -v logger >/dev/null 2>&1 && logger -t yami-greet -- "$*" 2>/dev/null
    return 0
}
# the result of this start, for `yami login status` and the shell's settings (readable by all)
result() {
    [ -d "$LG" ] && [ -w "$LG" ] || return 0
    printf '%s %s\n' "$(date '+%F %T')" "$*" >"$LG/.last" && chmod 644 "$LG/.last" && mv -f "$LG/.last" "$LG/last"
}

text() {
    say "$1: the text login this time"
    result "text $1"
    rm -f "$ST/fails"
    exec 1>&3 2>&4 0<&5 3>&- 4>&- 5<&-
    if command -v agreety >/dev/null 2>&1; then
        printf '\n  yami: %s, the text login this time (%s)\n\n' "$1" "$LOG"
        if command -v niri-session >/dev/null 2>&1; then exec agreety --cmd niri-session; fi
        exec agreety --cmd /bin/sh
    fi
    # no text greeter either: greetd starts us again; a pause keeps its restarts from running out
    sleep 10
    exit 1
}

uptime_s() { cut -d. -f1 /proc/uptime 2>/dev/null || echo 0; }

say "start (uptime $(uptime_s) s)"

# our own runtime folder: logind/elogind made it; without them (bare seatd) a private one, never
# a guessable name in /tmp
run=${XDG_RUNTIME_DIR:-} own=""
if [ -z "$run" ] || [ ! -d "$run" ] || [ -L "$run" ] || [ ! -O "$run" ] || [ ! -w "$run" ]; then
    run=$(mktemp -d "${TMPDIR:-/tmp}/yami-greet.XXXXXX") || text "no runtime folder"
    own=$run
    say "no XDG_RUNTIME_DIR from the session, using $run"
fi
bye() {
    [ -n "$own" ] && rm -rf -- "$own"
    exit "$1"
}
export XDG_RUNTIME_DIR="$run"
cfg="$run/yami-greet.kdl"
status="$run/yami-greet.status"

NIRI=$(command -v niri 2>/dev/null)
for n in /usr/bin/niri /usr/local/bin/niri; do
    [ -n "$NIRI" ] && break
    [ -x "$n" ] && NIRI=$n
done
export YAMI_GREET_NIRI="$NIRI"

fails=$(cat "$ST/fails" 2>/dev/null)
case $fails in '' | *[!0-9]*) fails=0 ;; esac
[ "$fails" -ge 2 ] && text "it did not come up $fails times in a row"
[ -n "$NIRI" ] || text "no niri"
[ -x "$G" ] || text "no $G"
# the config is made at every start from the look the shell published (yami-greet kdl checks it);
# a niri that rejects it gets the plain one
if ! { "$G" kdl >"$cfg" && "$NIRI" validate -c "$cfg" >/dev/null 2>&1; }; then
    say "niri rejects the full config, the plain one"
    { "$G" kdl --plain >"$cfg" && "$NIRI" validate -c "$cfg"; } || text "niri accepts no config"
fi

# a GPU driver that loads late (no drm-module-load target here): up to 10 s for a DRM card
i=0
while ! ls /dev/dri/card* >/dev/null 2>&1 && [ $i -lt 10 ]; do
    sleep 1
    i=$((i + 1))
done

# power off, reboot, greetd stopping: not a failure, niri goes with us
stop=0 np=""
trap 'stop=1; [ -n "$np" ] && kill "$np" 2>/dev/null' TERM INT HUP

try=1
while :; do
    rm -f "$status" "$run/yami-greet.rc"
    say "try $try: $("$NIRI" --version 2>/dev/null | head -n1), $("$G" --version 2>/dev/null)"
    t0=$(uptime_s)
    NO_COLOR=1 RUST_LOG=${RUST_LOG:-niri=info,smithay=warn,warn} "$NIRI" -c "$cfg" <&5 3>&- 4>&- 5<&- &
    np=$!
    wait "$np"
    nrc=$?
    # a trap interrupts wait: the niri it killed still has to go
    [ "$stop" = 1 ] && wait "$np" 2>/dev/null
    np=""
    lived=$(($(uptime_s) - t0))
    if [ "$stop" = 1 ]; then
        say "stopped (shutdown or greetd)"
        bye 0
    fi
    set -- $(cat "$status" 2>/dev/null)
    st=${1:-} ms=${2:-}
    rc=$(cat "$run/yami-greet.rc" 2>/dev/null)
    if [ "$st" = session ]; then
        rm -f "$ST/fails"
        say "a session starts (first frame after ${ms} ms)"
        result "ok ${ms}"
        bye 0
    fi
    say "ended without a session: ${st:-never shown}, yami-greet ${rc:-no code}, niri $nrc, after ${lived} s"
    # never showed a frame: niri, the seat or the GPU were not ready; again, a little later
    if [ "$st" != up ] && [ $try -lt 3 ]; then
        sleep $try
        try=$((try + 1))
        continue
    fi
    break
done
# shown and closed after a while (greetd restarts us): not a failure; never shown, or gone at once
if [ "$st" != up ] || [ "$lived" -lt 20 ]; then
    fails=$((fails + 1))
    echo "$fails" >"$ST/fails" 2>/dev/null
    result "fail ${st:-never shown}, yami-greet ${rc:-no code}, niri $nrc"
    # a quick exit makes greetd restart at once: a pause keeps it under its restart limit
    [ "$lived" -lt 5 ] && sleep 3
else
    result "closed ${st}, yami-greet ${rc:-no code}, niri $nrc"
fi
bye 1
