// Иконка 7×7 из битмапа (те же, что в шелле: gfx.rs icon7), клетками cell
import QtQuick

Item {
    id: ic
    property string name: "lock"
    property int cell: 2
    property color color: "white"
    readonly property var rows: ({
        "lock": ["..###..", ".#...#.", ".#...#.", "#######", "###.###", "###.###", "#######"],
        "power": ["...#...", ".#.#.#.", "#..#..#", "#.....#", "#.....#", ".#...#.", "..###.."],
        "reboot": ["..####.", ".#...##", "#...###", "#......", "#.....#", ".#...#.", "..###.."],
        "moon": ["..###..", ".##....", "##.....", "##.....", "##.....", ".##...#", "..####."],
        "left": ["...#...", "..#....", ".#.....", "#######", ".#.....", "..#....", "...#..."],
        "right": ["...#...", "....#..", ".....#.", "#######", ".....#.", "....#..", "...#..."],
        "grid": ["##.##..", "##.##..", ".......", "##.##..", "##.##..", ".......", "......."],
        "kb": ["#######", "#.#.#.#", "#######", "#.#.#.#", "#######", "#.....#", "#######"],
        "user": ["..###..", ".#####.", ".#####.", "..###..", ".......", ".#####.", "#######"],
        "warn": ["...#...", "..###..", "..#.#..", ".##.##.", ".#####.", "##.#.##", "#######"]
    })
    width: 7 * cell
    height: 7 * cell
    Repeater {
        model: 49
        Rectangle {
            readonly property int cx: index % 7
            readonly property int cy: Math.floor(index / 7)
            visible: (ic.rows[ic.name] || [])[cy] !== undefined && ic.rows[ic.name][cy][cx] === "#"
            x: cx * ic.cell
            y: cy * ic.cell
            width: ic.cell
            height: ic.cell
            color: ic.color
        }
    }
}
